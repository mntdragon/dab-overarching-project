---
import { getEntryBySlug } from "astro:content";
import RealtimeIsland from "../../components/RealtimeIsland.svelte";

const slug = Astro.params.slug;
const entry = await getEntryBySlug("basic", Array.isArray(slug) ? slug.join("/") : slug);

if (!entry) return new Response("Not found", { status: 404 });

const { Content } = await entry.render();
---

<html>
  <head><title>{entry.data.title}</title></head>
  <body>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.summary}</p>
    <Content components={{ RealtimeIsland }} />
  </body>
</html>
