{
  "imports": {
    "hono": "jsr:@hono/hono@^4.11.8",
     "hono/streaming": "jsr:@hono/hono@^4.11.8/streaming"
  },
  "tasks": {
    "start": "deno run --allow-net main.ts",
     "dev": "deno run --watch --allow-net --allow-env main.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  }
}
